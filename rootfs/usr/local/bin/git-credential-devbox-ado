#!/bin/sh
# Git credential helper for Azure DevOps: the Entra token from your own `az login` is the password, so no PAT.
# Git runs it from the repo, so a repo under /work/<name> uses <name>'s login even from an editor's git panel,
# which has no shell to set AZURE_CONFIG_DIR.
[ "$1" = get ] || exit 0
if [ -z "${AZURE_CONFIG_DIR-}" ]; then
    name=${PWD#/work/}
    name=${name%%/*}
    [ -n "$name" ] && [ -d "/work/$name/.devbox/azure" ] && export AZURE_CONFIG_DIR="/work/$name/.devbox/azure"
fi
token=$(az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 --query accessToken -o tsv) || exit 0
printf 'username=devbox\npassword=%s\n' "$token"
